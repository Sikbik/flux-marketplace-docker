# Enshrouded (VPS/local) example
#
# Copy to .env and edit. For Flux marketplace deployments, use flux-spec.json as a starting point.

# SteamCMD / install
AUTO_UPDATE=true
STEAMCMD_VALIDATE=true
STEAM_BRANCH=

# If anonymous stops working, use a Steam account that owns Enshrouded:
# STEAM_LOGIN=yourSteamUser
# STEAM_PASSWORD=yourSteamPassword
# STEAM_GUARD=123456

# Server basics
ENS_SERVER_NAME=RunOnFlux - Enshrouded (VPS)
ENS_PASSWORD=test1234
ENS_SLOT_COUNT=16
ENS_QUERY_PORT=15637
ENS_IP=0.0.0.0
ENS_GAME_SETTINGS_PRESET=Default
ENS_ENABLE_TEXT_CHAT=false
ENS_ENABLE_VOICE_CHAT=false
ENS_VOICE_CHAT_MODE=Proximity

# Flux note: keep logs local to reduce syncthing churn
# ENS_LOG_DIR=/data/logs

# Disk preflight
DISK_PREFLIGHT=true
MIN_FREE_GB=30

# Flux hardening (default true in image)
HARDEN_FLUX_VOLUME_BROWSER=true
